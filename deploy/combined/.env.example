# Copy to .env (in this directory) and adjust before `docker compose up -d`.

# Registry the image is published to (see .github/workflows/ci.yml).
REGISTRY_HOST=registry.example.internal:5000
IMAGE_TAG=latest

# The folder holding your library (<Creator>/<Release>/…). Mounted read-only.
LIBRARY_PATH=/path/to/STL

# Where the web UI is reachable. Keep 127.0.0.1 unless the host is only on
# a network you trust.
APP_BIND_HOST=127.0.0.1
APP_PORT=8080

# Time between library rescans (at least 1m).
SCAN_INTERVAL=1h

# Importing (only with docker-compose.import.yml): the downloads folder new
# models arrive in, how often to look, and how long a download folder must
# be unchanged before it counts as complete.
IMPORT_PATH=/path/to/downloads
IMPORT_INTERVAL=1h
IMPORT_SETTLE=1h

# Printer (optional): ELEGOO SDCP printer on your network, e.g. 192.168.1.50.
# Can also be set on the app's Settings page (which then takes precedence).
PRINTER_ADDR=

# Sign-in. PUBLIC_URL is the exact address users open (https://… or
# http://localhost:…); it turns on passkeys. Google sign-in additionally
# needs an OAuth client (redirect URI <PUBLIC_URL>/login/oauth2/code/google).
PUBLIC_URL=
# false: after the first account (yours - register right after the first
# start), only admins add accounts.
OPEN_REGISTRATION=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs sessions and encrypts stored secrets (at least 32 characters, e.g.
# `openssl rand -base64 48`). Left empty, one is generated into the data
# volume.
APP_SECRET=
# true behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
